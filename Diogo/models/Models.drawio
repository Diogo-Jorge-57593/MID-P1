                <mxCell id="aQUfkFHdEVYSLhgmH6Wx-72" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Operation&lt;/font&gt;&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Frequency&lt;/font&gt;&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Fields needed&lt;/font&gt;&lt;/span&gt;&lt;/th&gt;&lt;th&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Design implication&lt;/font&gt;&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;List client accounts&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;High&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Client ID; account details&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Separate accounts collection referencing client.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Consult account movements within period&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Very high&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Account ID; booking date, direction, amount, currency, description&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Keep movements in CSV, linked by account ID.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Review credit application&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;High&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Application details; client profile; responsible employee&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Application references client and optional employee.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Change application status&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Medium&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Application ID; status&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Keep current status directly in application document.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Summarise applications by status and period&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Low — daily&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Submission date, status, requested amount&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Keep aggregation fields together in applications.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Summarise applications by employee&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Low — weekly&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Employee ID/name; application date, status, amount&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Store employees separately; reference from applications.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Calculate client movement totals&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Medium&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Client–account links; movement dates, directions, amounts&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Combine MongoDB accounts with CSV movements.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Identify transfer movements&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Low — occasional&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Transfer ID; account IDs, directions, amounts, currencies&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Shared optional transfer ID links paired movements.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
